{
  "expo": {
    "name": "SK Technology",
    "slug": "sk-technology-cctv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sktechnology.cctv",
      "infoPlist": {
        "NSCameraUsageDescription": "SK Technology needs access to your camera to capture work proofs.",
        "NSLocationWhenInUseUsageDescription": "SK Technology needs your location for shift punch-ins."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070b14",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.sktechnology.cctv",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for shift attendance."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to capture job photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ]
  }
}
