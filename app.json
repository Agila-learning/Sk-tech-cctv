{
  "expo": {
    "name": "SK Technology",
    "slug": "sk-technology-cctv",
    "version": "1.0.23",
    "scheme": "sktechnology",
    "orientation": "default",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sktechnology.cctv",
      "infoPlist": {
        "NSCameraUsageDescription": "SK Technology needs access to your camera to capture work proofs.",
        "NSLocationWhenInUseUsageDescription": "SK Technology needs your location for shift punch-ins."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070b14",
        "foregroundImage": "./assets/app-icon.png"
      },
      "package": "com.sktechnology.cctv",
      "googleServicesFile": "./google-services.json",
      "versionCode": 24
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "notification": {
      "icon": "./assets/app-icon.png",
      "color": "#070b14"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for shift attendance."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to capture job photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon.png",
          "color": "#0D8ABC",
          "defaultChannel": "high_priority_alerts",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "7c77c8c3-80d7-4133-b5d1-4a9f91edfa61"
      }
    },
    "owner": "agila-g"
  }
}
